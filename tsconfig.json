{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "nodenext",
    "target": "esnext",

    "types": ["node"],

    "sourceMap": true,

    "strict": true,

    "skipLibCheck": true
  },

  "include": ["src/**/*"],

  "exclude": [
    "node_modules",
    "dist",
    "prisma.config.ts"
  ]
}