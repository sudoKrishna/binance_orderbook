// Get a free hosted Postgres database in seconds: `npx create-db`
enum Side {
 BUY
 SELL
}

enum Type {
  LIMIT
  MARKET
}
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  // body     Body[]
}

